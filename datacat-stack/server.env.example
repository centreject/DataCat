DATACAT_TEST_DB_PORT=13306
DATACAT_TEST_MODEL_PORT=18000
DATACAT_TEST_DB_PASSWORD=datacat-week9-local
DATACAT_TEST_DB_ROOT_PASSWORD=datacat-week9-root-local
