# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git 에 올리지 않는다.
APP_PORT=8081
API_PORT=8080

# 목업 API 가 이 간격(초)마다 새 방문을 하나씩 만든다. 0 이면 끔
MOCK_AUTO_VISIT_SECONDS=180

# --profile backend (MySQL) — 서버 PC 에서는 비밀번호를 꼭 바꾸기
DB_NAME=datacat
DB_USER=datacat
DB_PASSWORD=datacat-local
DB_ROOT_PASSWORD=root-local
DB_PORT=3307

# --profile tunnel (Cloudflare Zero Trust → Tunnels 에서 발급한 토큰)
CF_TUNNEL_TOKEN=
