              "PUBLIC_EMERGENCY",
              "SAFETY_REVIEW",
              "PICKUP",
              "WRONG_VISIT",
              "DELIVERY",
              "SERVICE_VISIT",
              "PERSONAL_VISIT",
              "SOLICITATION",
              "UNKNOWN"
            ],
            "title": "Purpose"
          },
          "subtype": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtype"
          },
          "flags": {
            "items": {
              "type": "string",
              "enum": [
                "NO_SPEECH",
                "SUMMARY_FROM_TRANSCRIPT",
                "RULES_FALLBACK"
              ]
            },
            "type": "array",
            "title": "Flags"
